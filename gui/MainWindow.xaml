<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        x:Name="Root" Title="EasyRomsToOPL"
        Height="820" Width="1240" MinHeight="700" MinWidth="1040"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="#050505" Foreground="#CCCCCC"
        FontFamily="JetBrains Mono,Cascadia Mono,Consolas"
        FontSize="12" UseLayoutRounding="True" SnapsToDevicePixels="True">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="6"
                        GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>

    <!-- ================= paleta (terminal.css) ================= -->
    <SolidColorBrush x:Key="Bg"       Color="#050505"/>
    <SolidColorBrush x:Key="Surface"  Color="#000000"/>
    <SolidColorBrush x:Key="Line"     Color="#333333"/>
    <SolidColorBrush x:Key="Muted"    Color="#666666"/>
    <SolidColorBrush x:Key="Fg"       Color="#CCCCCC"/>
    <SolidColorBrush x:Key="Cyan"     Color="#8BE9FD"/>
    <SolidColorBrush x:Key="Green"    Color="#50FA7B"/>
    <SolidColorBrush x:Key="Red"      Color="#FF5555"/>
    <SolidColorBrush x:Key="Yellow"   Color="#F1FA8C"/>
    <SolidColorBrush x:Key="Purple"   Color="#BD93F9"/>
    <SolidColorBrush x:Key="Pink"     Color="#FF79C6"/>

    <!-- ================= texto ================= -->
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style x:Key="H1" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Cyan}"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style x:Key="Dim" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="10"/>
    </Style>

    <!-- ================= botões ================= -->
    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#333333"/>
                <Setter TargetName="b" Property="BorderBrush" Value="#555555"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Background" Value="#8BE9FD"/>
                <Setter Property="Foreground" Value="#050505"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="{StaticResource Cyan}"/>
      <Setter Property="Foreground" Value="#050505"/>
      <Setter Property="BorderBrush" Value="{StaticResource Cyan}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#FFFFFF"/>
                <Setter TargetName="b" Property="BorderBrush" Value="#FFFFFF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Background" Value="#50FA7B"/>
                <Setter TargetName="b" Property="BorderBrush" Value="#50FA7B"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Foreground" Value="{StaticResource Red}"/>
      <Setter Property="BorderBrush" Value="#663333"/>
    </Style>

    <Style x:Key="BtnInfo" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Foreground" Value="{StaticResource Purple}"/>
      <Setter Property="BorderBrush" Value="#443366"/>
    </Style>

    <Style x:Key="BtnTiny" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Padding" Value="6,3"/>
      <Setter Property="FontSize" Value="10"/>
    </Style>

    <!-- chip de seleção (drive / modo) -->
    <Style x:Key="Chip" TargetType="ToggleButton">
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,6,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="b" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="#666666"/>
                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Cyan}"/>
                <Setter TargetName="b" Property="Background" Value="#0D2B33"/>
                <Setter Property="Foreground" Value="{StaticResource Cyan}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- botões da barra de título -->
    <Style x:Key="BtnWin" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#1A1A1A"/>
                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BtnWinClose" TargetType="Button" BasedOn="{StaticResource BtnWin}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{StaticResource Red}"/>
          <Setter Property="Foreground" Value="#050505"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- ================= campos ================= -->
    <Style x:Key="Tb" TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,7"/>
      <Setter Property="FontFamily" Value="JetBrains Mono,Cascadia Mono,Consolas"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="CaretBrush" Value="{StaticResource Cyan}"/>
      <Setter Property="SelectionBrush" Value="{StaticResource Cyan}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="b" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                            VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsFocused" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Cyan}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ================= barra de progresso ================= -->
    <Style x:Key="Bar" TargetType="ProgressBar">
      <Setter Property="Height" Value="10"/>
      <Setter Property="Background" Value="#141414"/>
      <Setter Property="Foreground" Value="{StaticResource Cyan}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
              <Grid ClipToBounds="True">
                <Rectangle Name="PART_Track"/>
                <Rectangle Name="PART_Indicator" HorizontalAlignment="Left"
                           Fill="{TemplateBinding Foreground}"/>
                <!-- brilho que varre a barra enquanto a instalação roda -->
                <Rectangle Name="Shimmer" Width="90" HorizontalAlignment="Left"
                           Visibility="Collapsed" IsHitTestVisible="False">
                  <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                      <GradientStop Color="#00FFFFFF" Offset="0"/>
                      <GradientStop Color="#88FFFFFF" Offset="0.5"/>
                      <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                  </Rectangle.Fill>
                  <Rectangle.RenderTransform>
                    <TranslateTransform x:Name="ShimmerShift" X="0"/>
                  </Rectangle.RenderTransform>
                </Rectangle>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsIndeterminate" Value="True">
                <Setter TargetName="Shimmer" Property="Visibility" Value="Visible"/>
                <Trigger.EnterActions>
                  <BeginStoryboard Name="ShimmerLoop">
                    <Storyboard RepeatBehavior="Forever">
                      <DoubleAnimation Storyboard.TargetName="ShimmerShift"
                                       Storyboard.TargetProperty="X"
                                       From="-90" To="1400" Duration="0:0:1.4"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <StopStoryboard BeginStoryboardName="ShimmerLoop"/>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ================= painéis ================= -->
    <Style x:Key="Panel" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="PanelHeader" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="Padding" Value="10,7"/>
    </Style>

    <Style TargetType="ScrollViewer">
      <Setter Property="Background" Value="Transparent"/>
    </Style>

  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="34"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="24"/>
    </Grid.RowDefinitions>

    <!-- ============================ BARRA DE TÍTULO ============================ -->
    <Border Grid.Row="0" Background="{StaticResource Surface}"
            BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
          <TextBlock Text="▓▒░" Foreground="{StaticResource Cyan}" FontWeight="Bold" Margin="0,0,8,0"/>
          <TextBlock Text="EASYROMS" Foreground="{StaticResource Cyan}" FontWeight="Bold" FontSize="13"/>
          <TextBlock Text="::OPL" Foreground="{StaticResource Muted}" FontWeight="Bold" FontSize="13"/>
        </StackPanel>

        <TextBlock Grid.Column="1" Text="INSTALADOR DE JOGOS PS2  /  PENDRIVE OPL USB"
                   Foreground="#4A4A4A" FontSize="10" VerticalAlignment="Center"
                   HorizontalAlignment="Center"/>

        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <ToggleButton x:Name="BtnSound" Style="{StaticResource Chip}" Content="SOM: ON" IsChecked="True"
                        Padding="8,3" FontSize="9" Margin="0,0,8,0" VerticalAlignment="Center"
                        ToolTip="Liga/desliga os sons da interface (ficam salvos para a próxima vez)"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button x:Name="BtnHelp" Style="{StaticResource BtnWin}" Content="?"
                  ToolTip="Glossário: formatos, colunas, status e plataformas"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button x:Name="BtnMin" Style="{StaticResource BtnWin}" Content="—"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button x:Name="BtnMax" Style="{StaticResource BtnWin}" Content="□"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button x:Name="BtnClose" Style="{StaticResource BtnWinClose}" Content="✕"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============================ CONTEÚDO ============================ -->
    <Grid Grid.Row="1" Margin="14">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="10"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="10"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="10"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- 01/02: jogo + nome (tudo em cima, largura cheia) -->
      <Border Grid.Row="0" Style="{StaticResource Panel}">
        <StackPanel Margin="10">
          <Grid Margin="0,0,0,6">
            <TextBlock Style="{StaticResource Section}" Text="01 // JOGO" Margin="0"/>
            <ToggleButton x:Name="BtnAuto" Style="{StaticResource Chip}" Content="INSTALAR AO SOLTAR"
                          IsChecked="True" HorizontalAlignment="Right" Margin="0" Padding="8,3" FontSize="9"
                          ToolTip="Solte o jogo e ele já começa a instalar no pendrive selecionado"/>
          </Grid>
          <Border x:Name="DropZone" Style="{StaticResource Panel}" Height="96" Cursor="Hand">
            <Grid>
              <Rectangle Stroke="#3A3A3A" StrokeThickness="1" StrokeDashArray="4 3" Margin="6"/>
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="DropTitle" Text="ARRASTE O JOGO AQUI"
                           Foreground="{StaticResource Cyan}" FontWeight="Bold" FontSize="13"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="ISO · ZIP · RAR · 7Z — ou clique para escolher"
                           Style="{StaticResource Dim}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
              </StackPanel>
            </Grid>
          </Border>

          <Grid Margin="0,8,0,6">
            <TextBlock x:Name="FileCount" Text="NENHUM ARQUIVO" Style="{StaticResource Dim}"/>
            <TextBlock x:Name="BtnClearFiles" Text="LIMPAR LISTA" Foreground="{StaticResource Muted}"
                       FontSize="10" HorizontalAlignment="Right" Cursor="Hand"
                       TextDecorations="Underline"/>
          </Grid>

          <StackPanel x:Name="FilesPanel" Margin="0,-4,0,8"/>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Style="{StaticResource Section}" Text="02 // NOME NO MENU DO OPL" Margin="0,0,0,4"/>
              <TextBox x:Name="NameBox" Style="{StaticResource Tb}" MaxLength="32"
                       ToolTip="Máximo 32 caracteres · acentos são removidos · não renomeie depois"/>
            </StackPanel>
            <Button Grid.Column="1" x:Name="BtnInstall" Style="{StaticResource BtnPrimary}"
                    Content="INSTALAR NO PENDRIVE" VerticalAlignment="Bottom" Margin="12,0,0,0"/>
          </Grid>

          <TextBlock x:Name="HintText" Style="{StaticResource Dim}" Margin="0,8,0,0"
                     TextWrapping="Wrap" Text="A origem pode ser qualquer disco/pasta do PC (ex.: E:\Jogos) — não precisa copiar para o pendrive antes. O app lê de onde está e grava no pendrive escolhido acima."/>
        </StackPanel>
      </Border>

      <!-- dispositivo -->
      <Border Grid.Row="2" Style="{StaticResource Panel}">
        <StackPanel>
          <Border Style="{StaticResource PanelHeader}">
            <Grid>
              <TextBlock Text="DISPOSITIVO" Foreground="{StaticResource Cyan}" FontSize="10" FontWeight="Bold"/>
              <TextBlock x:Name="DriveCount" Text="" Style="{StaticResource Dim}" HorizontalAlignment="Right"/>
            </Grid>
          </Border>
          <StackPanel Margin="10,8,10,10">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <WrapPanel Grid.Column="0" x:Name="DrivesPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="DeviceName" Text="—" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource Cyan}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="StatSpace" Text="—" Style="{StaticResource Dim}"/>
              </StackPanel>
              <TextBlock Grid.Column="1" x:Name="StatGames" Text="" Style="{StaticResource Dim}"
                         HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
            <ProgressBar x:Name="Bar" Style="{StaticResource Bar}" Value="0" Margin="0,8,0,0"/>
            <Grid Margin="0,6,0,0">
              <TextBlock x:Name="BarText" Text="OCIOSO" Style="{StaticResource Dim}"/>
              <TextBlock x:Name="BarPct" Text="" Style="{StaticResource Dim}" HorizontalAlignment="Right"/>
            </Grid>
          </StackPanel>
        </StackPanel>
      </Border>

        <!-- jogos -->
        <Border Grid.Row="4" Style="{StaticResource Panel}" MinHeight="180">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource PanelHeader}">
              <Grid>
                <TextBlock Text="JOGOS NA UNIDADE" Foreground="{StaticResource Cyan}" FontSize="10" FontWeight="Bold"/>
                <TextBlock x:Name="BtnRefresh" Text="RECARREGAR" Foreground="{StaticResource Muted}"
                           FontSize="10" HorizontalAlignment="Right" Cursor="Hand" TextDecorations="Underline"/>
              </Grid>
            </Border>

            <!-- abas: OPL (instalados) / biblioteca (tudo que existe na unidade) -->
            <Grid Grid.Row="1" Margin="10,8,10,0">
              <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="TabOpl" Style="{StaticResource Chip}" Content="OPL (UL.*)" IsChecked="True"/>
                <ToggleButton x:Name="TabLibrary" Style="{StaticResource Chip}" Content="BIBLIOTECA"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="LibraryInfo" Text="" Style="{StaticResource Dim}"
                           VerticalAlignment="Center" Margin="0,0,10,6"/>
                <Button x:Name="BtnInstallSelected" Style="{StaticResource BtnTiny}" Content="INSTALAR SELECIONADOS"
                        Foreground="{StaticResource Cyan}" BorderBrush="#2B5F6B"
                        VerticalAlignment="Center" Margin="0,0,0,6" Visibility="Collapsed"/>
              </StackPanel>
            </Grid>

            <!-- visão OPL -->
            <Grid x:Name="OplView" Grid.Row="2">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>

              <Grid Grid.Row="0" Margin="10,6,10,2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2.4*"/>
                  <ColumnDefinition Width="1.5*"/>
                  <ColumnDefinition Width="0.7*"/>
                  <ColumnDefinition Width="0.6*"/>
                  <ColumnDefinition Width="1.1*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="NOME" Style="{StaticResource Section}" Margin="0"
                           ToolTip="📝 NOME DO JOGO NO OPL
Máximo 32 caracteres, acentos são removidos automaticamente.
Este é o nome que aparece no menu do PlayStation 2.
Exemplo: 'Medal of Honor' ao invés de 'Medal of Honor (SLUS_215.97)'"/>
                <TextBlock Grid.Column="1" Text="SERIAL" Style="{StaticResource Section}" Margin="0"
                           ToolTip="🔢 CÓDIGO DO JOGO (SERIAL)
Identificador único lido do SYSTEM.CNF dentro do ISO.
Formato: REGIÃO_XXX.YY (ex: SLUS_215.97)
- SLUS = América do Norte (USA)
- SCES = Europa (PAL)
- SLPM = Japão
- SCPS = Asia
O OPL usa este código para identificar jogos duplicados."/>
                <TextBlock Grid.Column="2" Text="MODO" Style="{StaticResource Section}" Margin="0"
                           ToolTip="📀 MÍDIA ORIGINAL
DVD = Jogo original em DVD (4.7 GB)
CD = Jogo original em CD (700 MB)
O OPL precisa saber a mídia para configurar o drive corretamente.
ISO = Arquivo inteiro na pasta DVD\ (não dividido em UL.*)"/>
                <TextBlock Grid.Column="3" Text="PARTES" Style="{StaticResource Section}" Margin="0"
                           ToolTip="🔗 DIVISÃO EM PARTES (UL.*)
Quantos pedaços de 1 GiB o ISO foi dividido.
Necessário porque o sistema de arquivos FAT32 (pendrive)
não suporta arquivos maiores que 4 GB.
Jogo de 4.5 GB = 5 partes (ul.xxxx.00 a ul.xxxx.04)"/>
                <TextBlock Grid.Column="4" Text="CRC" Style="{StaticResource Section}" Margin="0"
                           ToolTip="🔐 ASSINATURA DE VERIFICAÇÃO (CRC)
Código calculado pelo OPL a partir do nome do jogo.
Se o CRC não corresponder, o jogo aparece no menu
mas não inicia (tela preta).
Garante que o nome não foi alterado após a instalação."/>
              </Grid>

              <TextBlock Grid.Row="1" Margin="10,0,10,4" FontSize="9" Foreground="#555555" TextWrapping="Wrap"
                         Text="UL.* = ISO DIVIDIDO EM PEDAÇOS DE 1 GiB · DVD\ = ISO INTEIRO LIDO DIRETO · MODO = MÍDIA ORIGINAL (DVD/CD) · ? = GLOSSÁRIO"/>

              <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="10,0,10,10">
                <StackPanel x:Name="GamesPanel"/>
              </ScrollViewer>
            </Grid>

            <!-- visão BIBLIOTECA (todas as plataformas) -->
            <Grid x:Name="LibraryView" Grid.Row="2" Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>

              <Grid Grid.Row="0" Margin="10,6,10,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="22"/>
                  <ColumnDefinition Width="72"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="" Margin="0">
                  <TextBlock.ToolTip>
                    <ToolTip Content="Marque a caixa das linhas para instalar vários jogos de uma vez."/>
                  </TextBlock.ToolTip>
                </TextBlock>
                <TextBlock Grid.Column="1" Text="PLATAFORMA" Style="{StaticResource Section}" Margin="0"
                           ToolTip="🎮 PLATAFORMA DO JOGO
PS2 = PlayStation 2 (único executável no OPL)
PS1 = PlayStation 1 (consulta apenas)
SNES, N64, GBA = Nintendo (consulta apenas)
MEGA = Sega Genesis/Mega Drive
O OPL só executa jogos de PS2, outras plataformas são listadas para organização."/>
                <TextBlock Grid.Column="2" Text="JOGO" Style="{StaticResource Section}" Margin="0"
                           ToolTip="📁 JOGO DETECTADO
Nome do jogo (extraído do arquivo) e caminho relativo
dentro do pendrive.
Exemplo: 'Metal Gear Solid 3' em 'PS2/MGS3.iso'
Clique com botão direito para mais opções."/>
                <TextBlock Grid.Column="3" Text="TAMANHO" Style="{StaticResource Section}" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="4" Text="STATUS" Style="{StaticResource Section}" Margin="0"
                           ToolTip="📊 STATUS DO JOGO NA UNIDADE
INSTALADO = Já está formatado para o OPL (UL.* ou DVD\)
JÁ NO OPL = Cópia detectada do mesmo jogo já instalado
JÁ NO PENDRIVE = Já instalado em outra unidade
INSTALAR = Disponível para instalação no OPL
OUTROS = Plataforma não suportada pelo OPL (PS1, Nintendo, etc.)"/>
              </Grid>

              <!-- filtros: o que já está no pendrive x o que ainda pode ser instalado -->
              <WrapPanel x:Name="LibFilters" Grid.Row="1" Orientation="Horizontal" Margin="10,0,10,4"/>

              <TextBlock Grid.Row="2" Margin="10,0,10,4" FontSize="9" Foreground="#555555" TextWrapping="Wrap"
                         Text="INSTALADO = JÁ APARECE NO MENU DO OPL · JÁ NO PENDRIVE = NÃO PRECISA INSTALAR DE NOVO · OUTROS = SÓ CONSULTA · ? = GLOSSÁRIO"/>

              <TextBlock x:Name="LibWarn" Grid.Row="3" Margin="10,0,10,4" FontSize="9" FontWeight="Bold"
                         Foreground="{StaticResource Yellow}" TextWrapping="Wrap" Visibility="Collapsed"/>

              <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Padding="10,0,10,10">
                <StackPanel x:Name="LibraryPanel"/>
              </ScrollViewer>
            </Grid>
          </Grid>
        </Border>

        <!-- log (fechado por padrão: abre no cabeçalho) -->
        <Border Grid.Row="6" Style="{StaticResource Panel}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border x:Name="LogHeader" Grid.Row="0" Style="{StaticResource PanelHeader}" Cursor="Hand">
              <Grid>
                <TextBlock Text="LOG" Foreground="{StaticResource Cyan}" FontSize="10" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <TextBlock x:Name="BtnCopyLog" Text="COPIAR" Foreground="{StaticResource Muted}"
                             FontSize="10" Cursor="Hand" TextDecorations="Underline" Margin="0,0,12,0"/>
                  <TextBlock x:Name="BtnLogToggle" Text="ABRIR ▾" Foreground="{StaticResource Muted}"
                             FontSize="10" Cursor="Hand" TextDecorations="Underline"/>
                </StackPanel>
              </Grid>
            </Border>
            <Border x:Name="LogBody" Grid.Row="1" Visibility="Collapsed" MaxHeight="230">
              <RichTextBox x:Name="LogBox" IsReadOnly="True" BorderThickness="0"
                           Background="{StaticResource Bg}" Foreground="{StaticResource Fg}"
                           FontFamily="JetBrains Mono,Cascadia Mono,Consolas" FontSize="11"
                           VerticalScrollBarVisibility="Auto" Padding="8,6"
                           IsUndoEnabled="False" AcceptsReturn="True"/>
            </Border>
          </Grid>
        </Border>
    </Grid>

    <!-- ============================ BARRA DE STATUS ============================ -->
    <Border Grid.Row="2" Background="{StaticResource Surface}"
            BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
      <Grid Margin="12,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse x:Name="BusyDot" Width="6" Height="6" Fill="{StaticResource Green}"
                   VerticalAlignment="Center" Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
              <ScaleTransform x:Name="BusyDotScale" ScaleX="1" ScaleY="1"/>
            </Ellipse.RenderTransform>
            <Ellipse.Triggers>
              <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                  <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="BusyDotScale"
                                     Storyboard.TargetProperty="ScaleX"
                                     From="1" To="1.9" Duration="0:0:0.55"
                                     AutoReverse="True"/>
                    <DoubleAnimation Storyboard.TargetName="BusyDotScale"
                                     Storyboard.TargetProperty="ScaleY"
                                     From="1" To="1.9" Duration="0:0:0.55"
                                     AutoReverse="True"/>
                    <DoubleAnimation Storyboard.TargetName="BusyDot"
                                     Storyboard.TargetProperty="Opacity"
                                     From="1" To="0.45" Duration="0:0:0.55"
                                     AutoReverse="True"/>
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
            </Ellipse.Triggers>
          </Ellipse>
          <TextBlock x:Name="StatusText" Text="PRONTO" FontSize="10" Foreground="{StaticResource Muted}"/>
        </StackPanel>
        <TextBlock Text="USE APENAS CÓPIAS QUE VOCÊ POSSUI" FontSize="9" Foreground="{StaticResource Yellow}"
                   Opacity="0.65" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TextBlock x:Name="VersionText" Text="EASYROMSTOOPL 1.2.0 · MIT" FontSize="10" Foreground="#3A3A3A"
                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <!-- ============================ TOASTS ============================ -->
    <StackPanel x:Name="Toasts" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Right"
                Margin="0,20,20,0" Width="380" IsHitTestVisible="True"/>

    <!-- ============================ OVERLAY DE CONFIRMAÇÃO ============================ -->
    <Grid x:Name="Overlay" Grid.RowSpan="3" Background="#D9000000" Visibility="Collapsed">
      <Border Style="{StaticResource Panel}" Width="460" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel>
          <Border Style="{StaticResource PanelHeader}">
            <TextBlock x:Name="ConfirmTitle" Text="CONFIRMAR" Foreground="{StaticResource Yellow}"
                       FontSize="10" FontWeight="Bold"/>
          </Border>
          <TextBlock x:Name="ConfirmText" Margin="16" TextWrapping="Wrap" LineHeight="19"/>
          <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="BtnCancelConfirm" Style="{StaticResource Btn}" Content="CANCELAR" Margin="0,0,8,0"/>
              <Button x:Name="BtnYesConfirm" Style="{StaticResource BtnPrimary}" Content="CONFIRMAR"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ============================ FICHA DO JOGO ============================ -->
    <Grid x:Name="InfoOverlay" Grid.RowSpan="3" Background="#E6000000" Visibility="Collapsed">
      <Border Style="{StaticResource Panel}" Width="560" MaxHeight="620"
              VerticalAlignment="Center" HorizontalAlignment="Center">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Style="{StaticResource PanelHeader}">
            <Grid>
              <TextBlock x:Name="InfoTitle" Text="FICHA DO JOGO" Foreground="{StaticResource Cyan}"
                         FontSize="10" FontWeight="Bold"/>
              <TextBlock x:Name="InfoStatus" Style="{StaticResource Dim}" HorizontalAlignment="Right"/>
            </Grid>
          </Border>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,14,18,6">
            <StackPanel x:Name="InfoPanel"/>
          </ScrollViewer>

          <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="BtnInfoClose" Style="{StaticResource BtnPrimary}" Content="FECHAR"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <!-- ============================ GLOSSÁRIO / AJUDA ============================ -->
    <Grid x:Name="HelpOverlay" Grid.RowSpan="3" Background="#E6000000" Visibility="Collapsed">
      <Border Style="{StaticResource Panel}" Width="760" MaxHeight="660"
              VerticalAlignment="Center" HorizontalAlignment="Center">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Style="{StaticResource PanelHeader}">
            <Grid>
              <TextBlock Text="GLOSSÁRIO — COMO LER A TELA" Foreground="{StaticResource Cyan}"
                         FontSize="10" FontWeight="Bold"/>
              <TextBlock Text="ESC FECHA" Style="{StaticResource Dim}" HorizontalAlignment="Right"/>
            </Grid>
          </Border>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,14,18,6">
            <StackPanel x:Name="HelpPanel"/>
          </ScrollViewer>

          <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="BtnHelpClose" Style="{StaticResource BtnPrimary}" Content="FECHAR"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>

  </Grid>
</Window>
