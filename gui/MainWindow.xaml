<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        x:Name="Root" Title="EasyRomsToOPL"
        Height="820" Width="1240" MinHeight="700" MinWidth="1040"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="#050505" Foreground="#CCCCCC"
        FontFamily="JetBrains Mono,Cascadia Mono,Consolas"
        FontSize="12" UseLayoutRounding="True" SnapsToDevicePixels="True">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="6"
                        GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>

    <!-- ================= paleta (terminal.css) ================= -->
    <SolidColorBrush x:Key="Bg"       Color="#050505"/>
    <SolidColorBrush x:Key="Surface"  Color="#000000"/>
    <SolidColorBrush x:Key="Line"     Color="#333333"/>
    <SolidColorBrush x:Key="Muted"    Color="#666666"/>
    <SolidColorBrush x:Key="Fg"       Color="#CCCCCC"/>
    <SolidColorBrush x:Key="Cyan"     Color="#8BE9FD"/>
    <SolidColorBrush x:Key="Green"    Color="#50FA7B"/>
    <SolidColorBrush x:Key="Red"      Color="#FF5555"/>
    <SolidColorBrush x:Key="Yellow"   Color="#F1FA8C"/>
    <SolidColorBrush x:Key="Purple"   Color="#BD93F9"/>
    <SolidColorBrush x:Key="Pink"     Color="#FF79C6"/>

    <!-- ================= texto ================= -->
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style x:Key="H1" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Cyan}"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style x:Key="Dim" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="10"/>
    </Style>

    <!-- ================= botões ================= -->
    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#333333"/>
                <Setter TargetName="b" Property="BorderBrush" Value="#555555"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Background" Value="#8BE9FD"/>
                <Setter Property="Foreground" Value="#050505"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="{StaticResource Cyan}"/>
      <Setter Property="Foreground" Value="#050505"/>
      <Setter Property="BorderBrush" Value="{StaticResource Cyan}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#FFFFFF"/>
                <Setter TargetName="b" Property="BorderBrush" Value="#FFFFFF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Background" Value="#50FA7B"/>
                <Setter TargetName="b" Property="BorderBrush" Value="#50FA7B"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Foreground" Value="{StaticResource Red}"/>
      <Setter Property="BorderBrush" Value="#663333"/>
    </Style>

    <Style x:Key="BtnInfo" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Foreground" Value="{StaticResource Purple}"/>
      <Setter Property="BorderBrush" Value="#443366"/>
    </Style>

    <Style x:Key="BtnTiny" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Padding" Value="6,3"/>
      <Setter Property="FontSize" Value="10"/>
    </Style>

    <!-- chip de seleção (drive / modo) -->
    <Style x:Key="Chip" TargetType="ToggleButton">
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,6,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="b" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="#666666"/>
                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Cyan}"/>
                <Setter TargetName="b" Property="Background" Value="#0D2B33"/>
                <Setter Property="Foreground" Value="{StaticResource Cyan}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- botões da barra de título -->
    <Style x:Key="BtnWin" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#1A1A1A"/>
                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BtnWinClose" TargetType="Button" BasedOn="{StaticResource BtnWin}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{StaticResource Red}"/>
          <Setter Property="Foreground" Value="#050505"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- ================= campos ================= -->
    <Style x:Key="Tb" TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,7"/>
      <Setter Property="FontFamily" Value="JetBrains Mono,Cascadia Mono,Consolas"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="CaretBrush" Value="{StaticResource Cyan}"/>
      <Setter Property="SelectionBrush" Value="{StaticResource Cyan}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="b" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                            VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsFocused" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Cyan}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ================= barra de progresso ================= -->
    <Style x:Key="Bar" TargetType="ProgressBar">
      <Setter Property="Height" Value="10"/>
      <Setter Property="Background" Value="#141414"/>
      <Setter Property="Foreground" Value="{StaticResource Cyan}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
              <Grid>
                <Rectangle Name="PART_Track"/>
                <Rectangle Name="PART_Indicator" HorizontalAlignment="Left"
                           Fill="{TemplateBinding Foreground}"/>
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ================= painéis ================= -->
    <Style x:Key="Panel" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="PanelHeader" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="Padding" Value="10,7"/>
    </Style>

    <Style TargetType="ScrollViewer">
      <Setter Property="Background" Value="Transparent"/>
    </Style>

  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="34"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="24"/>
    </Grid.RowDefinitions>

    <!-- ============================ BARRA DE TÍTULO ============================ -->
    <Border Grid.Row="0" Background="{StaticResource Surface}"
            BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
          <TextBlock Text="▓▒░" Foreground="{StaticResource Cyan}" FontWeight="Bold" Margin="0,0,8,0"/>
          <TextBlock Text="EASYROMS" Foreground="{StaticResource Cyan}" FontWeight="Bold" FontSize="13"/>
          <TextBlock Text="::OPL" Foreground="{StaticResource Muted}" FontWeight="Bold" FontSize="13"/>
        </StackPanel>

        <TextBlock Grid.Column="1" Text="INSTALADOR DE JOGOS PS2  /  PENDRIVE OPL USB"
                   Foreground="#4A4A4A" FontSize="10" VerticalAlignment="Center"
                   HorizontalAlignment="Center"/>

        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button x:Name="BtnMin" Style="{StaticResource BtnWin}" Content="—"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button x:Name="BtnMax" Style="{StaticResource BtnWin}" Content="□"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button x:Name="BtnClose" Style="{StaticResource BtnWinClose}" Content="✕"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============================ CONTEÚDO ============================ -->
    <Grid Grid.Row="1" Margin="14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.15*"/>
        <ColumnDefinition Width="14"/>
        <ColumnDefinition Width="1*"/>
      </Grid.ColumnDefinitions>

      <!-- coluna esquerda -->
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
        <StackPanel>

          <TextBlock Style="{StaticResource Section}" Text="01 // IMAGENS DE JOGO"/>
          <Border x:Name="DropZone" Style="{StaticResource Panel}" Height="118" Cursor="Hand">
            <Grid>
              <Rectangle Stroke="#3A3A3A" StrokeThickness="1" StrokeDashArray="4 3" Margin="6"/>
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="DropTitle" Text="ARRASTE OS .ISO AQUI"
                           Foreground="{StaticResource Cyan}" FontWeight="Bold" FontSize="13"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="ou clique para escolher no disco"
                           Style="{StaticResource Dim}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
              </StackPanel>
            </Grid>
          </Border>

          <Grid Margin="0,8,0,16">
            <TextBlock x:Name="FileCount" Text="NENHUM ARQUIVO" Style="{StaticResource Dim}"/>
            <TextBlock x:Name="BtnClearFiles" Text="LIMPAR LISTA" Foreground="{StaticResource Muted}"
                       FontSize="10" HorizontalAlignment="Right" Cursor="Hand"
                       TextDecorations="Underline"/>
          </Grid>

          <StackPanel x:Name="FilesPanel" Margin="0,-8,0,14"/>

          <TextBlock Style="{StaticResource Section}" Text="02 // MODO DE INSTALAÇÃO"/>
          <StackPanel x:Name="ModePanel" Orientation="Horizontal" Margin="0,0,0,10"/>

          <TextBlock Style="{StaticResource Section}" Text="03 // NOME NO MENU DO OPL"/>
          <TextBox x:Name="NameBox" Style="{StaticResource Tb}" MaxLength="32"/>
          <TextBlock Style="{StaticResource Dim}" Margin="0,6,0,18"
                     Text="MÁXIMO 32 CARACTERES · ACENTOS SÃO REMOVIDOS · NÃO RENOMEIE DEPOIS"/>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="1.4*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnSimulate" Grid.Column="0" Style="{StaticResource BtnInfo}" Content="SIMULAR"/>
            <Button x:Name="BtnInstall" Grid.Column="2" Style="{StaticResource BtnPrimary}" Content="INSTALAR NO PENDRIVE"/>
          </Grid>

          <TextBlock x:Name="HintText" Style="{StaticResource Dim}" Margin="0,10,0,0"
                     TextWrapping="Wrap" Text="A instalação grava pedaços de 1 GiB e atualiza o ul.cfg. Nada é apagado sem confirmação."/>

          <Border Style="{StaticResource Panel}" Margin="0,20,0,0">
            <StackPanel>
              <Border Style="{StaticResource PanelHeader}">
                <TextBlock Text="FLUXO" Foreground="{StaticResource Cyan}" FontSize="10" FontWeight="Bold"/>
              </Border>
              <StackPanel Margin="12">
                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="01" Foreground="{StaticResource Cyan}" FontSize="10" FontWeight="Bold"/>
                  <TextBlock Grid.Column="1" Text="Arraste o .iso (ou vários) para a área acima."
                             TextWrapping="Wrap" FontSize="10" Foreground="#999999"/>
                </Grid>
                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="02" Foreground="{StaticResource Cyan}" FontSize="10" FontWeight="Bold"/>
                  <TextBlock Grid.Column="1" Text="Confira o serial lido do SYSTEM.CNF e o modo de instalação."
                             TextWrapping="Wrap" FontSize="10" Foreground="#999999"/>
                </Grid>
                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="03" Foreground="{StaticResource Cyan}" FontSize="10" FontWeight="Bold"/>
                  <TextBlock Grid.Column="1" Text="SIMULAR mostra o plano. INSTALAR grava e valida o tamanho."
                             TextWrapping="Wrap" FontSize="10" Foreground="#999999"/>
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="04" Foreground="{StaticResource Cyan}" FontSize="10" FontWeight="Bold"/>
                  <TextBlock Grid.Column="1" Text="Ejete com segurança e teste no PS2 antes de fechar tudo."
                             TextWrapping="Wrap" FontSize="10" Foreground="#999999"/>
                </Grid>
                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,12,0,10"/>
                <TextBlock Text="USE APENAS CÓPIAS DE JOGOS QUE VOCÊ POSSUI."
                           Foreground="{StaticResource Yellow}" FontSize="9" FontWeight="Bold"
                           TextWrapping="Wrap"/>
                <TextBlock Text="Esta ferramenta não baixa nem distribui jogos."
                           Foreground="#555555" FontSize="9" Margin="0,4,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>

      <!-- coluna direita -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="12"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="12"/>
          <RowDefinition Height="230"/>
        </Grid.RowDefinitions>

        <!-- pendrive -->
        <Border Grid.Row="0" Style="{StaticResource Panel}">
          <StackPanel>
            <Border Style="{StaticResource PanelHeader}">
              <Grid>
                <TextBlock Text="PENDRIVE" Foreground="{StaticResource Cyan}" FontSize="10" FontWeight="Bold"/>
                <TextBlock x:Name="DriveCount" Text="" Style="{StaticResource Dim}" HorizontalAlignment="Right"/>
              </Grid>
            </Border>
            <StackPanel Margin="10">
              <StackPanel x:Name="DrivesPanel" Orientation="Horizontal"/>
              <Grid Margin="0,2,0,10">
                <TextBlock x:Name="StatSpace" Text="—" Style="{StaticResource Dim}"/>
                <TextBlock x:Name="StatGames" Text="" Style="{StaticResource Dim}" HorizontalAlignment="Right"/>
              </Grid>
              <ProgressBar x:Name="Bar" Style="{StaticResource Bar}" Value="0"/>
              <Grid Margin="0,6,0,0">
                <TextBlock x:Name="BarText" Text="OCIOSO" Style="{StaticResource Dim}"/>
                <TextBlock x:Name="BarPct" Text="" Style="{StaticResource Dim}" HorizontalAlignment="Right"/>
              </Grid>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- jogos -->
        <Border Grid.Row="2" Style="{StaticResource Panel}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource PanelHeader}">
              <Grid>
                <TextBlock Text="JOGOS NO PENDRIVE" Foreground="{StaticResource Cyan}" FontSize="10" FontWeight="Bold"/>
                <TextBlock x:Name="BtnRefresh" Text="RECARREGAR" Foreground="{StaticResource Muted}"
                           FontSize="10" HorizontalAlignment="Right" Cursor="Hand" TextDecorations="Underline"/>
              </Grid>
            </Border>

            <!-- cabeçalho da tabela -->
            <Grid Grid.Row="1" Margin="10,8,10,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.4*"/>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="0.7*"/>
                <ColumnDefinition Width="0.6*"/>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="NOME" Style="{StaticResource Section}" Margin="0"/>
              <TextBlock Grid.Column="1" Text="SERIAL" Style="{StaticResource Section}" Margin="0"/>
              <TextBlock Grid.Column="2" Text="MODO" Style="{StaticResource Section}" Margin="0"/>
              <TextBlock Grid.Column="3" Text="PARTES" Style="{StaticResource Section}" Margin="0"/>
              <TextBlock Grid.Column="4" Text="CRC" Style="{StaticResource Section}" Margin="0"/>
            </Grid>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="10,0,10,10">
              <StackPanel x:Name="GamesPanel"/>
            </ScrollViewer>
          </Grid>
        </Border>

        <!-- log -->
        <Border Grid.Row="4" Style="{StaticResource Panel}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource PanelHeader}">
              <Grid>
                <TextBlock Text="LOG" Foreground="{StaticResource Cyan}" FontSize="10" FontWeight="Bold"/>
                <TextBlock x:Name="BtnCopyLog" Text="COPIAR" Foreground="{StaticResource Muted}"
                           FontSize="10" HorizontalAlignment="Right" Cursor="Hand" TextDecorations="Underline"/>
              </Grid>
            </Border>
            <RichTextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" BorderThickness="0"
                         Background="{StaticResource Bg}" Foreground="{StaticResource Fg}"
                         FontFamily="JetBrains Mono,Cascadia Mono,Consolas" FontSize="11"
                         VerticalScrollBarVisibility="Auto" Padding="8,6"
                         IsUndoEnabled="False" AcceptsReturn="True"/>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- ============================ BARRA DE STATUS ============================ -->
    <Border Grid.Row="2" Background="{StaticResource Surface}"
            BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
      <Grid Margin="12,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse x:Name="BusyDot" Width="6" Height="6" Fill="{StaticResource Green}"
                   VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock x:Name="StatusText" Text="PRONTO" FontSize="10" Foreground="{StaticResource Muted}"/>
        </StackPanel>
        <TextBlock Text="EASYROMSTOOPL 1.1.0 · MIT" FontSize="10" Foreground="#3A3A3A"
                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <!-- ============================ TOASTS ============================ -->
    <StackPanel x:Name="Toasts" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Right"
                Margin="0,20,20,0" Width="380" IsHitTestVisible="True"/>

    <!-- ============================ OVERLAY DE CONFIRMAÇÃO ============================ -->
    <Grid x:Name="Overlay" Grid.RowSpan="3" Background="#D9000000" Visibility="Collapsed">
      <Border Style="{StaticResource Panel}" Width="460" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel>
          <Border Style="{StaticResource PanelHeader}">
            <TextBlock x:Name="ConfirmTitle" Text="CONFIRMAR" Foreground="{StaticResource Yellow}"
                       FontSize="10" FontWeight="Bold"/>
          </Border>
          <TextBlock x:Name="ConfirmText" Margin="16" TextWrapping="Wrap" LineHeight="19"/>
          <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="BtnCancelConfirm" Style="{StaticResource Btn}" Content="CANCELAR" Margin="0,0,8,0"/>
              <Button x:Name="BtnYesConfirm" Style="{StaticResource BtnPrimary}" Content="CONFIRMAR"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </Grid>

  </Grid>
</Window>
